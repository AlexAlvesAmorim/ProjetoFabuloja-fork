# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fabuloja?schema=public"

# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# JWT (gere com: openssl rand -base64 32 — em produção o server não sobe sem 32+ chars)
JWT_SECRET="troque-por-um-segredo-forte-de-32-mais-caracteres"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Proxy reverso na frente (Render/Fly): necessário pro rate-limit ver o IP real
TRUST_PROXY="false"

# Cookie (deploy separado exige sameSite=none; nesse modo o secure é forçado)
COOKIE_SAMESITE="strict"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Login (anti brute-force) e tracking público (anti-spam)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_TRACK_MAX=60
RATE_LIMIT_TRACK_WINDOW_MS=60000

# WhatsApp
WHATSAPP_NUMBER="5521976807111"

# Seed (admin inicial — defina antes do primeiro seed em qualquer ambiente real)
SEED_ADMIN_EMAIL="admin@fabulosamodas.com"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte"